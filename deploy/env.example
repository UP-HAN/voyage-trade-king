# 중계 서버 설정 예시 → 서버의 /etc/voyage-relay.env (권한 640, root:voyage)
# 이름·기본값은 docs/server-setup.md 3.3 표와 같다(작업 105 server/src/config.ts가 읽음).
# 비어 있거나 줄이 없으면 기본값. 잘못된 값(숫자 자리에 글자 등)이면 서버가 이유를 출력하고 시작하지 않는다.
# 이 파일에 비밀값(키·토큰)을 넣지 않는다.

# ── 서버 ──
HOST=127.0.0.1
PORT=8787
# 접속을 허용할 웹 주소(쉼표로 여러 개, 경로 없이)
ALLOWED_ORIGINS=https://lab.ches.es.kr
# 이 주소(nginx)에서 온 연결만 X-Real-IP를 믿음
TRUST_PROXY=127.0.0.1
# 서버 공지 파일(없으면 공지 없음, 읽기만). 바꾼 뒤 sudo systemctl reload voyage-relay
NOTICE_FILE=/etc/voyage-relay.notice.json
# debug | info | warn | error
LOG_LEVEL=info
# Node 힙 한도(서버 크기별 값은 docs/server-setup.md 1.3.1 — 2GB 서버 256)
NODE_OPTIONS=--max-old-space-size=256
# 개발용(운영 서버에서는 쓰지 않음): 1이면 http://localhost:*, http://127.0.0.1:* 출처 허용
# ALLOW_LOCALHOST=0

# ── 상한(서버 크기에 맞춰 1.3.1 표) ──
MAX_ROOMS=50
MAX_PEERS=45
# = MAX_ROOMS × 46 (30방 1400, 10방 500)
MAX_CONN=2300
MAX_CONN_PER_IP=500
MAX_ROOMS_PER_IP=10
ROOM_CREATE_LIMIT=20
ROOM_CREATE_WINDOW=3600

# ── 정리·수명(초) ──
EMPTY_ROOM_TTL=1200
UNJOINED_TIMEOUT=30
IDLE_TTL=1800
HOST_GRACE=1800
MAX_ROOM_AGE=28800
CODE_REUSE_BLOCK=7200
# 서버 재시작 뒤 기록 없는 방 코드를 같은 코드로 다시 열 수 있는 시간
RESUME_GRACE=600

# ── 메시지·입장 제한 ──
MSG_RATE=20
MSG_BURST=40
# 호스트(교사 화면) 연결의 초당 메시지 수 / 순간 허용 — 학생 30명 응답·공개 상태를 보냄
HOST_MSG_RATE=120
HOST_MSG_BURST=240
MAX_MSG_BYTES=65536
JOIN_FAIL_LIMIT=30
JOIN_FAIL_WINDOW=300
JOIN_BLOCK_SEC=120
JOIN_BLOCK_MAX=1800
